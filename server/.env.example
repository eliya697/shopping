# Copy to server/.env for local development (server/.env is gitignored).
# On Render, set these in Dashboard -> your service -> Environment instead.

# Turso (libSQL). Leave empty locally to use server/data/shopping.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin dashboard. At least 16 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET_KEY=

# Optional: the owner email (defaults to eliyamistriel1234@gmail.com). Used for the dashboard
# login and to decide which app account has role "owner" (see server/roles.js).
# ADMIN_EMAIL=

# AI assistant (Google Gemini). Get a key at https://aistudio.google.com/apikey.
# Without it the app's AI tab explains that the assistant isn't configured.
GEMINI_API_KEY=
# Optional: override the model (default gemini-2.5-flash).
# GEMINI_MODEL=
