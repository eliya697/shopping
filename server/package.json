{
  "name": "shopping-list-server",
  "version": "1.0.0",
  "description": "Real-time backend for the shopping list PWA (Express + Socket.io + SQLite)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/v2.test.js && node test/v1-compat.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
